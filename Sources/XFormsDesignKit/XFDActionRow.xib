<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx" />
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127" />
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0" />
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="XFDActionRowTemplate">
            <connections>
                <outlet property="xpathRow" destination="xfd-ar-xpath" id="xfd-ar-o01" />
                <outlet property="xpathLabel" destination="xfd-ar-xpathl" id="xfd-ar-o02" />
                <outlet property="xpathField" destination="xfd-ar-xpathf" id="xfd-ar-o03" />
                <outlet property="idrefRow" destination="xfd-ar-idref" id="xfd-ar-o04" />
                <outlet property="idrefLabel" destination="xfd-ar-idrefl" id="xfd-ar-o05" />
                <outlet property="idrefField" destination="xfd-ar-idreff" id="xfd-ar-o06" />
                <outlet property="contentRow" destination="xfd-ar-content" id="xfd-ar-o07" />
                <outlet property="contentLabel" destination="xfd-ar-contentl" id="xfd-ar-o08" />
                <outlet property="contentField" destination="xfd-ar-contentf" id="xfd-ar-o09" />
                <outlet property="popupRow" destination="xfd-ar-popup" id="xfd-ar-o10" />
                <outlet property="popupLabel" destination="xfd-ar-popupl" id="xfd-ar-o11" />
                <outlet property="popupField" destination="xfd-ar-popupf" id="xfd-ar-o12" />
                <outlet property="fieldRow" destination="xfd-ar-field" id="xfd-ar-o13" />
                <outlet property="fieldLabel" destination="xfd-ar-fieldl" id="xfd-ar-o14" />
                <outlet property="fieldField" destination="xfd-ar-fieldf" id="xfd-ar-o15" />
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder" />
        <customObject id="-3" userLabel="Application" customClass="NSObject" />
        <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-xpath" userLabel="Xpath Row">
            <rect key="frame" x="0.0" y="0.0" width="280" height="26" />
            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" />
            <subviews>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-xpathl">
                    <rect key="frame" x="0" y="8" width="92" height="14" />
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES" />
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="clipping" alignment="right" title="Xpath" id="xfd-ar-xpathlc">
                        <font key="font" metaFont="smallSystem" />
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog" />
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog" />
                    </textFieldCell>
                </textField>
                <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-xpathf" customClass="XFDXPathField">
                    <rect key="frame" x="98" y="4" width="174" height="21" />
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" />
                </customView>
            </subviews>
        </customView>
        <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-idref" userLabel="Idref Row">
            <rect key="frame" x="0.0" y="0.0" width="280" height="26" />
            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" />
            <subviews>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-idrefl">
                    <rect key="frame" x="0" y="8" width="92" height="14" />
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES" />
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="clipping" alignment="right" title="Idref" id="xfd-ar-idreflc">
                        <font key="font" metaFont="smallSystem" />
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog" />
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog" />
                    </textFieldCell>
                </textField>
                <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-idreff" customClass="XFDIDRefField">
                    <rect key="frame" x="98" y="3" width="174" height="23" />
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" />
                </customView>
            </subviews>
        </customView>
        <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-content" userLabel="Content Row">
            <rect key="frame" x="0.0" y="0.0" width="280" height="26" />
            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" />
            <subviews>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-contentl">
                    <rect key="frame" x="0" y="8" width="92" height="14" />
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES" />
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="clipping" alignment="right" title="Content" id="xfd-ar-contentlc">
                        <font key="font" metaFont="smallSystem" />
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog" />
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog" />
                    </textFieldCell>
                </textField>
                <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-contentf" customClass="XFDRichTextField">
                    <rect key="frame" x="98" y="4" width="174" height="21" />
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" />
                </customView>
            </subviews>
        </customView>
        <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-popup" userLabel="Popup Row">
            <rect key="frame" x="0.0" y="0.0" width="280" height="26" />
            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" />
            <subviews>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-popupl">
                    <rect key="frame" x="0" y="8" width="92" height="14" />
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES" />
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="clipping" alignment="right" title="Popup" id="xfd-ar-popuplc">
                        <font key="font" metaFont="smallSystem" />
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog" />
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog" />
                    </textFieldCell>
                </textField>
                <popUpButton verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-popupf">
                    <rect key="frame" x="98" y="3" width="174" height="22" />
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" />
                    <popUpButtonCell key="cell" type="push" bezelStyle="rounded" alignment="left" controlSize="small" lineBreakMode="truncatingTail" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" id="xfd-ar-popupb">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES" />
                        <font key="font" metaFont="smallSystem" />
                        <menu key="menu" id="xfd-ar-popupm" />
                    </popUpButtonCell>
                </popUpButton>
            </subviews>
        </customView>
        <customView fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-field" userLabel="Field Row">
            <rect key="frame" x="0.0" y="0.0" width="280" height="26" />
            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" />
            <subviews>
                <textField focusRingType="none" horizontalHuggingPriority="251" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-fieldl">
                    <rect key="frame" x="0" y="8" width="92" height="14" />
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES" />
                    <textFieldCell key="cell" controlSize="small" lineBreakMode="clipping" alignment="right" title="Field" id="xfd-ar-fieldlc">
                        <font key="font" metaFont="smallSystem" />
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog" />
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog" />
                    </textFieldCell>
                </textField>
                <textField focusRingType="none" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ar-fieldf">
                    <rect key="frame" x="98" y="5" width="174" height="19" />
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" />
                    <textFieldCell key="cell" controlSize="small" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" drawsBackground="YES" id="xfd-ar-fieldc">
                        <font key="font" metaFont="smallSystem" />
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog" />
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog" />
                    </textFieldCell>
                </textField>
            </subviews>
        </customView>
    </objects>
</document>
