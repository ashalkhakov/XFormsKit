<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="YES" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx" />
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127" />
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0" />
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="XFDEventsConsoleViewController">
            <connections>
                <outlet property="view" destination="xfd-ec-vw" id="xfd-ec-001" />
                <outlet property="kindPopup" destination="xfd-ec-knd" id="xfd-ec-002" />
                <outlet property="filterField" destination="xfd-ec-flt" id="xfd-ec-003" />
                <outlet property="pauseButton" destination="xfd-ec-pau" id="xfd-ec-004" />
                <outlet property="table" destination="xfd-ec-tbl" id="xfd-ec-005" />
                <outlet property="countField" destination="xfd-ec-cnt" id="xfd-ec-006" />
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder" />
        <customObject id="-3" userLabel="Application" customClass="NSObject" />
        <customView translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ec-vw" userLabel="Events Console">
            <rect key="frame" x="0.0" y="0.0" width="720" height="420" />
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
            <subviews>
                <popUpButton verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ec-knd">
                    <rect key="frame" x="8" y="388" width="110" height="24" />
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES" />
                    <popUpButtonCell key="cell" type="push" title="All kinds" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" selectedItem="xfd-ec-k0" id="xfd-ec-kcl">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES" />
                        <font key="font" metaFont="system" />
                        <menu key="menu" id="xfd-ec-kmn">
                            <items>
                                <menuItem title="All kinds" state="on" id="xfd-ec-k0" />
                                <menuItem title="Events" id="xfd-ec-k1" />
                                <menuItem title="Handlers" id="xfd-ec-k2" />
                                <menuItem title="Actions" id="xfd-ec-k3" />
                                <menuItem title="Model" id="xfd-ec-k4" />
                                <menuItem title="Errors" id="xfd-ec-k5" />
                                <menuItem title="Warnings" id="xfd-ec-k6" />
                            </items>
                        </menu>
                    </popUpButtonCell>
                    <connections>
                        <action selector="filterChanged:" target="-2" id="xfd-ec-kac" />
                    </connections>
                </popUpButton>
                <textField focusRingType="none" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ec-flt">
                    <rect key="frame" x="126" y="390" width="344" height="21" />
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMinY="YES" />
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" selectable="YES" editable="YES" sendsActionOnEndEditing="YES" borderStyle="bezel" placeholderString="Filter (message or event name)" drawsBackground="YES" id="xfd-ec-flc">
                        <font key="font" metaFont="system" />
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog" />
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog" />
                    </textFieldCell>
                    <connections>
                        <action selector="filterChanged:" target="-2" id="xfd-ec-fac" />
                    </connections>
                </textField>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ec-pau">
                    <rect key="frame" x="476" y="388" width="70" height="24" />
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES" />
                    <buttonCell key="cell" type="push" title="Pause" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="xfd-ec-pac">
                        <behavior key="behavior" pushIn="YES" changeBackground="YES" changeGray="YES" lightByBackground="YES" lightByGray="YES" />
                        <font key="font" metaFont="system" />
                    </buttonCell>
                    <connections>
                        <action selector="pauseClicked:" target="-2" id="xfd-ec-paa" />
                    </connections>
                </button>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ec-clr">
                    <rect key="frame" x="550" y="388" width="70" height="24" />
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES" />
                    <buttonCell key="cell" type="push" title="Clear" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="xfd-ec-clc">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES" />
                        <font key="font" metaFont="system" />
                    </buttonCell>
                    <connections>
                        <action selector="clearClicked:" target="-2" id="xfd-ec-cla" />
                    </connections>
                </button>
                <button verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ec-sav">
                    <rect key="frame" x="624" y="388" width="92" height="24" />
                    <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMinY="YES" />
                    <buttonCell key="cell" type="push" title="Save Log…" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="xfd-ec-svc">
                        <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES" />
                        <font key="font" metaFont="system" />
                    </buttonCell>
                    <connections>
                        <action selector="saveClicked:" target="-2" id="xfd-ec-sva" />
                    </connections>
                </button>
                <scrollView fixedFrame="YES" horizontalLineScroll="19" horizontalPageScroll="10" verticalLineScroll="19" verticalPageScroll="10" hasHorizontalScroller="NO" usesPredominantAxisScrolling="NO" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ec-scr">
                    <rect key="frame" x="0.0" y="24" width="720" height="360" />
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                    <clipView key="contentView" id="xfd-ec-clp">
                        <rect key="frame" x="0.0" y="0.0" width="720" height="360" />
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                        <subviews>
                            <tableView verticalHuggingPriority="750" allowsExpansionToolTips="YES" columnAutoresizingStyle="lastColumnOnly" alternatingRowBackgroundColors="YES" multipleSelection="NO" autosaveColumns="NO" rowHeight="17" headerView="xfd-ec-hdr" id="xfd-ec-tbl">
                                <rect key="frame" x="0.0" y="0.0" width="720" height="337" />
                                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                                <size key="intercellSpacing" width="3" height="2" />
                                <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog" />
                                <color key="gridColor" name="gridColor" catalog="System" colorSpace="catalog" />
                                <tableColumns>
                                    <tableColumn identifier="delta" editable="NO" width="52" minWidth="30" maxWidth="1000" id="xfd-ec-c01">
                                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Δms">
                                            <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog" />
                                            <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog" />
                                        </tableHeaderCell>
                                        <textFieldCell key="dataCell" lineBreakMode="truncatingTail" title="Text Cell" id="xfd-ec-d01">
                                            <font key="font" metaFont="system" />
                                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog" />
                                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog" />
                                        </textFieldCell>
                                    </tableColumn>
                                    <tableColumn identifier="kind" editable="NO" width="62" minWidth="30" maxWidth="1000" id="xfd-ec-c02">
                                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Kind">
                                            <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog" />
                                            <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog" />
                                        </tableHeaderCell>
                                        <textFieldCell key="dataCell" lineBreakMode="truncatingTail" title="Text Cell" id="xfd-ec-d02">
                                            <font key="font" metaFont="system" />
                                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog" />
                                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog" />
                                        </textFieldCell>
                                    </tableColumn>
                                    <tableColumn identifier="event" editable="NO" width="150" minWidth="40" maxWidth="1000" id="xfd-ec-c03">
                                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Event">
                                            <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog" />
                                            <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog" />
                                        </tableHeaderCell>
                                        <textFieldCell key="dataCell" lineBreakMode="truncatingTail" title="Text Cell" id="xfd-ec-d03">
                                            <font key="font" metaFont="system" />
                                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog" />
                                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog" />
                                        </textFieldCell>
                                    </tableColumn>
                                    <tableColumn identifier="message" editable="NO" width="420" minWidth="40" maxWidth="5000" id="xfd-ec-c04">
                                        <tableHeaderCell key="headerCell" lineBreakMode="truncatingTail" borderStyle="border" title="Message">
                                            <color key="textColor" name="headerTextColor" catalog="System" colorSpace="catalog" />
                                            <color key="backgroundColor" name="headerColor" catalog="System" colorSpace="catalog" />
                                        </tableHeaderCell>
                                        <textFieldCell key="dataCell" lineBreakMode="truncatingTail" title="Text Cell" id="xfd-ec-d04">
                                            <font key="font" metaFont="system" />
                                            <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog" />
                                            <color key="backgroundColor" name="controlBackgroundColor" catalog="System" colorSpace="catalog" />
                                        </textFieldCell>
                                        <tableColumnResizingMask key="resizingMask" resizeWithTable="YES" />
                                    </tableColumn>
                                </tableColumns>
                                <connections>
                                    <outlet property="dataSource" destination="-2" id="xfd-ec-ds" />
                                    <outlet property="delegate" destination="-2" id="xfd-ec-dl" />
                                </connections>
                            </tableView>
                        </subviews>
                    </clipView>
                    <scroller key="horizontalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="YES" id="xfd-ec-hsc">
                        <rect key="frame" x="0.0" y="344" width="720" height="16" />
                        <autoresizingMask key="autoresizingMask" />
                    </scroller>
                    <scroller key="verticalScroller" hidden="YES" verticalHuggingPriority="750" horizontal="NO" id="xfd-ec-vsc">
                        <rect key="frame" x="704" y="23" width="16" height="337" />
                        <autoresizingMask key="autoresizingMask" />
                    </scroller>
                    <tableHeaderView key="headerView" wantsLayer="YES" id="xfd-ec-hdr">
                        <rect key="frame" x="0.0" y="0.0" width="720" height="23" />
                        <autoresizingMask key="autoresizingMask" />
                    </tableHeaderView>
                </scrollView>
                <textField focusRingType="none" verticalHuggingPriority="750" fixedFrame="YES" translatesAutoresizingMaskIntoConstraints="NO" id="xfd-ec-cnt">
                    <rect key="frame" x="8" y="3" width="704" height="17" />
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES" />
                    <textFieldCell key="cell" lineBreakMode="truncatingTail" title="" id="xfd-ec-cnc">
                        <font key="font" metaFont="smallSystem" />
                        <color key="textColor" name="labelColor" catalog="System" colorSpace="catalog" />
                        <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog" />
                    </textFieldCell>
                </textField>
            </subviews>
        </customView>
    </objects>
</document>
