# What XFormsKit builds on, by the exact versions of their releases:
# gnustep-release-actions' workflows (scripts/deps.sh) fetch them from here.
# To move one, edit it here.
#   Linux  the GNUstep stack's archive, unpacked into /opt/gnustep
#   Apple  Sparkle's XCFramework, unpacked into .deps/

# The patched GNUstep stack (ashalkhakov/gnustep-patches), with Opal and
# corebase, which the SVG renderer draws through.
GNUSTEP_PATCHES_VERSION=2026.10.20.36
# XFormsViewer's and XFormsDesigner's updates on macOS.
SPARKLE_VERSION=2.10.0
# UDCode's SDK (ashalkhakov/UDCodeKit's udcodekit archives): what the XForms
# extension builds on (UDCodeExtension/). The stack above is that UDCode
# release's: the extension uses UDCode's.
UDCODEKIT_VERSION=0.19.0
# What UDCode's SDK links on Windows, and so the installer's closure needs: the
# DiagramKit that UDCode release carries (ashalkhakov/DiagramKit).
DIAGRAMKIT_VERSION=0.2.1
