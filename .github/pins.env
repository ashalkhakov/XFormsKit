# The commits XFormsKit builds on: the one place they are named. CI, the
# release (through gnustep-release-actions/pins) and
# .github/scripts/dependencies.sh all read this file; to move a pin, edit it
# here. Full commit hashes only: a branch would move under the build.

# ashalkhakov/gnustep-patches: the fixes to GNUstep itself (libs-base,
# libs-gui, libs-corebase, Opal), applied to the stack. Part of every
# GNUstep cache key, so moving it rebuilds the stack. dcbad8f retires
# libs-base/nsxml-prefixed-descendants, merged upstream, which no longer
# applied to libs-base master.
# 7adc606 (#12): libs-base moved again (#843 merged; the stack builds
# from scratch again), and arc4random() on glibc before 2.36.
GNUSTEP_PATCHES_REF=7adc606d3ff7059f5099d2c4b798dd3a54bac075

# gershwin-desktop/gershwin-eau-theme, on dev (where Gershwin merges): the
# theme the AppImage looks as. The commit gnustep-patches builds against,
# so a change landing on dev cannot stop this build.
EAU_REF=01be00b5216b0ad508f30d66fa0d6734f44052c2
