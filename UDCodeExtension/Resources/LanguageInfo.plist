<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- XHTML+XForms forms: XML (the grammar the XML mode's), opened in
	     XFormsDesignKit's designer when the text has XForms in it
	     (XFUExtension's -workbench:editorForDocument:), as text otherwise.
	     The XML mode lists .xhtml as well; an installed extension's mode is
	     registered after it, and wins. -->
	<key>languageModes</key>
	<array>
		<dict>
			<key>identifier</key>
			<string>xforms</string>
			<key>displayName</key>
			<string>XHTML+XForms</string>
			<key>fileExtensions</key>
			<array>
				<string>xhtml</string>
			</array>
			<key>grammarOf</key>
			<string>xml</string>
		</dict>
	</array>
</dict>
</plist>
