<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="24127" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO" customObjectInstantitationMethod="direct">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="24127"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="XFUEditorViewController">
            <connections>
                <outlet property="view" destination="editorView" id="editorViewOutlet"/>
                <outlet property="problemView" destination="problemView" id="problemViewOutlet"/>
                <outlet property="problemLabel" destination="problemLabel" id="problemLabelOutlet"/>
                <outlet property="split" destination="editorSplit" id="editorSplitOutlet"/>
                <outlet property="outlineHost" destination="outlineHost" id="outlineHostOutlet"/>
                <outlet property="previewHost" destination="previewHost" id="previewHostOutlet"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSObject"/>
        <!-- The tab: the Document Outline (the form's elements) and the live
             preview, the designer's parts put in their hosts from code (the
             form is the text's); while the text is no form, why. -->
        <customView id="editorView" customClass="XFUEditorView" userLabel="XForms Editor">
            <rect key="frame" x="0" y="0" width="900" height="600"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <splitView arrangesAllSubviews="NO" dividerStyle="thin" vertical="YES" id="editorSplit" userLabel="Outline and Preview">
                    <rect key="frame" x="0" y="0" width="900" height="600"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <subviews>
                        <customView id="outlineHost" userLabel="Document Outline">
                            <rect key="frame" x="0" y="0" width="240" height="600"/>
                            <autoresizingMask key="autoresizingMask" heightSizable="YES"/>
                        </customView>
                        <customView id="previewHost" userLabel="Preview">
                            <rect key="frame" x="241" y="0" width="659" height="600"/>
                            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        </customView>
                    </subviews>
                    <holdingPriorities>
                        <real value="260"/>
                        <real value="250"/>
                    </holdingPriorities>
                    <connections>
                        <outlet property="delegate" destination="-2" id="editorSplitDelegate"/>
                    </connections>
                </splitView>
                <customView hidden="YES" id="problemView" userLabel="Not a Form">
                    <rect key="frame" x="0" y="0" width="900" height="600"/>
                    <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                    <subviews>
                        <textField verticalHuggingPriority="750" id="problemLabel">
                            <rect key="frame" x="150" y="300" width="600" height="60"/>
                            <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxX="YES" flexibleMinY="YES" flexibleMaxY="YES"/>
                            <textFieldCell key="cell" lineBreakMode="wordWrapping" selectable="YES" alignment="center" title="This is not a form that can be shown." id="problemLabelCell">
                                <font key="font" metaFont="system"/>
                                <color key="textColor" name="secondaryLabelColor" catalog="System" colorSpace="catalog"/>
                                <color key="backgroundColor" name="textBackgroundColor" catalog="System" colorSpace="catalog"/>
                            </textFieldCell>
                        </textField>
                        <button verticalHuggingPriority="750" id="showAsTextButton">
                            <rect key="frame" x="385" y="256" width="130" height="32"/>
                            <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxX="YES" flexibleMinY="YES" flexibleMaxY="YES"/>
                            <buttonCell key="cell" type="push" title="Show as Text" bezelStyle="rounded" alignment="center" borderStyle="border" imageScaling="proportionallyDown" inset="2" id="showAsTextButtonCell">
                                <behavior key="behavior" pushIn="YES" lightByBackground="YES" lightByGray="YES"/>
                                <font key="font" metaFont="system"/>
                            </buttonCell>
                            <connections>
                                <action selector="showAsText:" target="-2" id="showAsTextAction"/>
                            </connections>
                        </button>
                    </subviews>
                </customView>
            </subviews>
            <connections>
                <outlet property="controller" destination="-2" id="editorViewController"/>
            </connections>
        </customView>
    </objects>
</document>
