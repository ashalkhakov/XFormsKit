diff --git a/Source/NSXMLElement.m b/Source/NSXMLElement.m
index 7484209..c1833aa 100644
--- a/Source/NSXMLElement.m
+++ b/Source/NSXMLElement.m
@@ -324,8 +324,23 @@ GS_PRIVATE_INTERNAL(NSXMLElement)
         }
 
 #if LIBXML_VERSION >= 20620
-      xmlDOMWrapAdoptNode(NULL, attr->doc, (xmlNodePtr)attr, 
-                          theNode->doc, theNode, 0);
+      if (xmlDOMWrapAdoptNode(NULL, attr->doc, (xmlNodePtr)attr,
+        theNode->doc, theNode, 0) != 0)
+        {
+          /* libxml2 refuses to adopt an attribute whose namespace has no
+           * href (the placeholder -setName: makes for a prefix that is not
+           * declared yet, to be resolved once the element is placed), and
+           * xmlDOMWrapAdoptAttr fails only after it has moved the attribute
+           * itself and before it walks the value nodes.  Those are left
+           * pointing at the private document freed below, so the next
+           * thing to walk the attribute (a later -detach, or the parent's
+           * dealloc) reads freed memory.  Move the whole subtree ourselves
+           * instead.  The private document has no dictionary, so it owns
+           * none of the strings and a plain pointer update is enough.
+           */
+          attr->doc = tmp;
+          xmlSetTreeDoc((xmlNodePtr)attr, theNode->doc);
+        }
 #else
       xmlSetTreeDoc((xmlNodePtr)attr, theNode->doc);
 #endif
